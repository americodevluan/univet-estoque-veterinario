# ============================================================
# PROMPT MESTRE — Controle de Estoque Veterinário
# Exemplo de variáveis de ambiente (NUNCA versionar valores reais)
# Copie este arquivo para .env e preencha com seus valores.
# ============================================================

# --- Backend (backend/.env) ---

# Porta do servidor da API
PORT=3333

# URL de conexão com o PostgreSQL (local)
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/estoque_veterinario?schema=public"

# Segredo para assinatura dos tokens JWT (use um valor longo e aleatório)
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Tempo de expiração do token (ex.: 8h)
JWT_EXPIRES_IN=8h

# Origem permitida no CORS (URL do frontend)
CORS_ORIGIN="http://localhost:5173"

# --- Frontend (frontend/.env) ---

# URL base da API consumida pelo frontend
VITE_API_URL="http://localhost:3333/api"
